# Copy to .env next to docker-compose.yaml and fill in.
TZ=Europe/Berlin
# plus-stable (latest release), plus-latest (latest build) or a fixed tag like plus-2026.10.0
EOS_PLUS_TAG=plus-stable
# openssl rand -hex 16
EOSDASH_SESSKEY=
# Only for --profile history
EOS_HISTORY_PASSWORD=
# Only for --profile mcp: openssl rand -hex 32, and the host:port clients use
EOS_MCP_TOKEN=
EOS_MCP_ALLOWED_HOSTS=localhost:8505
