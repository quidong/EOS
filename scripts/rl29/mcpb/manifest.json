{
  "manifest_version": "0.2",
  "name": "eos-rl29",
  "display_name": "EOS energy management",
  "version": "1.0.0",
  "description": "Access to an Akkudoktor-EOS (RL29 fork) MCP server: plan, forecasts, key figures, model reports and allow-listed settings.",
  "long_description": "Connects Claude to the EOS MCP server (container eos-mcp, http://<host>:8505/mcp). Access needs the token from EOS_MCP_TOKEN; it is asked for at install time and stored securely. Keep the server inside your home network or behind a TLS reverse proxy.",
  "author": {
    "name": "RL29 fork of Akkudoktor-EOS",
    "url": "https://github.com/quidong/EOS"
  },
  "server": {
    "type": "node",
    "entry_point": "server/node_modules/mcp-remote/dist/proxy.js",
    "mcp_config": {
      "command": "node",
      "args": [
        "${__dirname}/server/node_modules/mcp-remote/dist/proxy.js",
        "${user_config.url}",
        "--allow-http",
        "--transport",
        "http-only",
        "--header",
        "Authorization: Bearer ${user_config.token}"
      ]
    }
  },
  "tools": [
    {
      "name": "eos_status",
      "description": "Health, algorithm, latest plan"
    },
    {
      "name": "eos_plan",
      "description": "Plan per slot"
    },
    {
      "name": "eos_forecast",
      "description": "Prediction series (price, PV, load, weather)"
    },
    {
      "name": "eos_kpis",
      "description": "Forecast accuracy and realised costs"
    },
    {
      "name": "eos_hours",
      "description": "Actual vs predicted per hour"
    },
    {
      "name": "eos_reports",
      "description": "Reports of the learning models"
    },
    {
      "name": "eos_config_get",
      "description": "Read configuration (secrets masked)"
    },
    {
      "name": "eos_config_set",
      "description": "Change an allow-listed value"
    },
    {
      "name": "eos_config_undo",
      "description": "Undo the last change"
    },
    {
      "name": "eos_config_save",
      "description": "Persist the configuration"
    }
  ],
  "user_config": {
    "url": {
      "type": "string",
      "title": "EOS MCP URL",
      "description": "URL of the eos-mcp container, e.g. http://192.0.2.10:8505/mcp",
      "default": "http://localhost:8505/mcp",
      "required": true
    },
    "token": {
      "type": "string",
      "title": "Token (EOS_MCP_TOKEN)",
      "description": "Value of EOS_MCP_TOKEN of the eos-mcp container",
      "sensitive": true,
      "required": true
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ],
    "runtimes": {
      "node": ">=20.0.0"
    }
  },
  "license": "Apache-2.0"
}
