        "config_entry_id": {
          "name": "EOS entry",
          "description": "Only needed with several EOS instances."
        },
        "start": {
          "name": "Start",
          "description": "Empty = from now."
        },
        "return_at": {
          "name": "Return",
          "description": "Time of the return."
        }
      }
    },
    "end_holiday": {
      "name": "End holiday",
      "description": "Ends the holiday set by action.",
      "fields": {
        "config_entry_id": {
          "name": "EOS entry",
          "description": "Only needed with several EOS instances."
        }
      }
    },
    "request_run": {
      "name": "Request an appliance run",
      "description": "A home appliance shall be done by a time; EOS plans the cheapest start.",
      "fields": {
        "config_entry_id": {
          "name": "EOS entry",
          "description": "Only needed with several EOS instances."
        },
        "device": {
          "name": "Device",
          "description": "EOS device id of the home appliance."
        },
        "finish_by": {
          "name": "Finish by",
          "description": "Latest end."
        },
        "duration": {
          "name": "Duration",
          "description": "Program duration (empty = value of EOS)."
        }
      }
    },
    "cancel_run": {
      "name": "Cancel an appliance run",
