        "config_entry_id": {
          "name": "EOS entry",
          "description": "Only needed with several EOS instances."
        }
      }
    },
    "set_holiday": {
      "name": "Set holiday",
      "description": "Holiday from/until: EOS plans with absence and heats up for the return.",
