        "config_entry_id": {
          "name": "EOS entry",
          "description": "Only needed with several EOS instances."
        },
        "until": {
          "name": "Until",
          "description": "End of the lock."
        },
        "duration": {
          "name": "Duration",
          "description": "Lock from now for this duration."
        }
      }
    },
    "clear_reduction_lock": {
      "name": "Clear the reduction lock",
